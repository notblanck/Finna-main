# Server Configuration
PORT=4000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Account Aggregator Mode Toggle
# Set to 'false' to enable live Setu Account Aggregator flow, or 'true' for offline mock demo flow
USE_MOCK_AA=true

# Setu Account Aggregator Credentials & Config (Required when USE_MOCK_AA=false)
# Obtain these from Setu Bridge Dashboard: https://bridge.setu.co
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_PRODUCT_INSTANCE_ID=your-setu-product-instance-id

# Setu Endpoints
# Sandbox: https://fiu-sandbox.setu.co | Production: https://fiu.setu.co
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_URL=https://accountservice.setu.co/v1/users/login

# Frontend Redirect / Return URL after Setu consent approval/rejection
SETU_REDIRECT_URL=http://localhost:3000/mock-aa/callback

# ML Income Prediction Microservice
ML_SERVICE_URL=http://localhost:8000

